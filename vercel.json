{
  "rewrites": [
    { "source": "/counselor",        "destination": "/counselor.html" },
    { "source": "/c",                "destination": "/counselor.html" },
    { "source": "/feedback",         "destination": "/feedback.html" },
    { "source": "/instructor-portal","destination": "/instructor-portal.html" },
    { "source": "/i",                "destination": "/instructor-portal.html" },
    { "source": "/session-report",   "destination": "/session-report.html" },
    { "source": "/master-report",    "destination": "/master-report.html" },
    { "source": "/",                 "destination": "/student.html" },
    { "source": "/student",          "destination": "/student.html" },
    { "source": "/s",                "destination": "/student.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/(student|counselor|instructor-portal|feedback|session-report|master-report|s|c|i)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/assets/shared\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
